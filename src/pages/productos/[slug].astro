---
// Página de detalle de producto: una por cada pieza del catálogo.
// Astro genera una ruta estática por cada `slug` en /src/data/products.ts.
import Layout from "@/layouts/Layout.astro";
import AnnouncementBar from "@/components/AnnouncementBar.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Medio from "@/components/Medio.astro";
import RevealScript from "@/components/RevealScript.astro";
import { products, type Product } from "@/data/products";
import { siteConfig, whatsappLink } from "@/data/site";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props as { product: Product };

// Descripciones con respaldo mientras no llegue la ficha completa de cada pieza.
const resumen = product.descripcionCorta ?? product.detail;
// Primero se intenta recomendar piezas de la misma categoría; si no hay
// suficientes (p. ej. cuando sólo hay 1-2 mesas en el catálogo), se
// completa con el resto de la colección para no dejar la sección vacía.
const mismaCategoria = products.filter((p) => p.category === product.category && p.slug !== product.slug);
const otras = products.filter((p) => p.category !== product.category);
const relacionados = [...mismaCategoria, ...otras].slice(0, 3);

const galeria = [product.image, ...(product.galeria ?? [])];

const tituloSeo = `${product.name} — Colección 2026 | ${siteConfig.name}`;
const descripcionSeo = `${resumen} Ref. ${product.ref}. Disponible al detal y al por mayor desde 6 unidades, envíos a todo Colombia.`;

const mensajeWhatsapp = `Hola, quiero cotizar la pieza ${product.name} (ref. ${product.ref}) de la colección 2026 de Sillarte.`;

// Datos estructurados para buscadores (schema.org/Product).
// Se omite "offers" a propósito: todavía no hay precio real publicado.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  sku: product.ref,
  category: product.category,
  description: descripcionSeo,
  image: new URL(product.image, Astro.site ?? "https://sillarte.co").toString(),
  brand: {
    "@type": "Brand",
    name: siteConfig.name,
  },
};
---

<Layout title={tituloSeo} description={descripcionSeo} image={product.image} type="product">
  <div class="header-fijo">
    <AnnouncementBar />
    <Nav />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <main id="contenido">
    <section class="producto seccion seccion--marmol">
      <div class="contenedor">
        <nav class="producto__migas" aria-label="Ruta de navegación">
          <a href="/#destacados">Colección 2026</a>
          <span aria-hidden="true">/</span>
          <a href="/#categorias">{product.category}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{product.name}</span>
        </nav>

        <div class="producto__grid">
          <div class="producto__galeria">
            <button
              type="button"
              class="producto__medio-principal"
              data-abrir-zoom
              aria-label={`Ampliar foto de ${product.name}`}
            >
              <Medio
                src={product.image}
                alt={`${product.name}, ${product.detail}`}
                marcador={`Foto de producto — ${product.name}`}
                loading="eager"
                fetchpriority="high"
                data-galeria-principal
              />
              <span class="producto__zoom-icono" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <circle cx="11" cy="11" r="7" />
                  <line x1="16.5" y1="16.5" x2="21" y2="21" />
                  <line x1="11" y1="8" x2="11" y2="14" />
                  <line x1="8" y1="11" x2="14" y2="11" />
                </svg>
              </span>
            </button>

            {galeria.length > 1 && (
              <div class="producto__miniaturas" role="group" aria-label="Más fotos de esta pieza">
                {galeria.map((src, index) => (
                  <button
                    type="button"
                    class="producto__miniatura"
                    class:list={{ "producto__miniatura--activa": index === 0 }}
                    data-galeria-miniatura
                    data-src={src}
                    aria-label={`Ver foto ${index + 1} de ${product.name}`}
                  >
                    <img src={src} alt="" loading="lazy" onerror="this.closest('.producto__miniatura').style.display='none'" />
                  </button>
                ))}
              </div>
            )}
          </div>

          <div class="producto__info">
            <p class="etiqueta reveal">{product.category} · Ref. {product.ref}</p>
            <h1 class="titular producto__titulo reveal">{product.name}</h1>
            <p class="producto__precio reveal">
              $— <span>según cantidad y condición de compra</span>
            </p>
            <p class="producto__resumen reveal">{resumen}</p>

            <div class="producto__acciones reveal">
              <a
                href={whatsappLink(mensajeWhatsapp)}
                target="_blank"
                rel="noopener noreferrer"
                class="boton boton--dorado"
              >
                Cotizar esta pieza
              </a>
              <a href="/#mayoreo" class="boton boton--linea">Cotización de mayoreo</a>
            </div>

            <ul class="producto__confianza reveal">
              <li>Precios de mayoreo desde 6 unidades</li>
              <li>Envíos a todo Colombia</li>
              <li>Respuesta en máximo 24 horas</li>
            </ul>

            <div class="producto__extendida reveal">
              <h2>Sobre esta pieza</h2>
              <p>
                {product.descripcionLarga ?? (
                  `${product.detail}. Hace parte de la colección 2026: pensada para combinar directamente con el resto de mesas, bancos y sillas de la familia, con un mismo lenguaje de materiales y tonos. Escríbenos para conocer fichas técnicas, tiempos de entrega y condiciones de compra al detal o al por mayor.`
                )}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {product.ficha && (
      <section class="ficha seccion seccion--clara" aria-labelledby="ficha-titulo">
        <div class="contenedor ficha__grid">
          <div class="reveal">
            <p class="etiqueta">Ficha técnica</p>
            <h2 id="ficha-titulo" class="titular ficha__titulo">Hecha para durar.</h2>
          </div>

          <dl class="ficha__lista reveal">
            {Object.entries(product.ficha).map(([campo, valor]) => (
              <div class="ficha__item">
                <dt>{campo}</dt>
                <dd>{valor}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    {relacionados.length > 0 && (
      <section class="relacionados seccion seccion--marmol" aria-labelledby="relacionados-titulo">
        <div class="contenedor">
          <p class="etiqueta reveal">Combina con</p>
          <h2 id="relacionados-titulo" class="titular relacionados__titulo reveal">
            Otras piezas de la colección.
          </h2>

          <div class="relacionados__grid">
            {relacionados.map((rel) => (
              <a href={`/productos/${rel.slug}/`} class="relacionados__tarjeta reveal">
                <Medio
                  src={rel.image}
                  alt={`${rel.name}, ${rel.detail}`}
                  marcador={`Foto de producto — ${rel.name}`}
                  class="medio--marcador-arriba"
                />
                <div class="relacionados__ficha">
                  <h3>{rel.name}</h3>
                  <span>Ref. {rel.ref}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
  <RevealScript />

  <div class="lightbox" data-lightbox hidden>
    <button type="button" class="lightbox__fondo" data-lightbox-cerrar aria-label="Cerrar"></button>

    <button type="button" class="lightbox__cerrar" data-lightbox-cerrar aria-label="Cerrar foto ampliada">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="5" y1="5" x2="19" y2="19" />
        <line x1="19" y1="5" x2="5" y2="19" />
      </svg>
    </button>

    {galeria.length > 1 && (
      <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Foto anterior">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </button>
    )}

    <div class="lightbox__marco">
      <img class="lightbox__imagen" data-lightbox-imagen src="" alt="" />
    </div>

    {galeria.length > 1 && (
      <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Foto siguiente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </button>
    )}

    <p class="lightbox__ayuda">Toca la foto para acercar</p>
  </div>
</Layout>

<style>
  .header-fijo {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
  }

  .producto {
    padding-top: clamp(7rem, 14vw, 9rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .producto__migas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--gris);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .producto__migas a:hover {
    color: var(--dorado-texto);
    text-decoration: underline;
  }

  .producto__migas [aria-current="page"] {
    color: var(--carbon);
    font-weight: 600;
  }

  .producto__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .producto__medio-principal {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 1rem;
    overflow: hidden;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    cursor: zoom-in;
  }

  .producto__medio-principal:focus-visible {
    outline: 3px solid var(--dorado-texto);
    outline-offset: 3px;
  }

  .producto__zoom-icono {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: rgba(20, 18, 16, 0.72);
    color: var(--hueso);
    opacity: 0.85;
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .producto__zoom-icono svg {
    width: 18px;
    height: 18px;
  }

  .producto__medio-principal:hover .producto__zoom-icono,
  .producto__medio-principal:focus-visible .producto__zoom-icono {
    opacity: 1;
    transform: scale(1.08);
  }

  .producto__medio-principal :global(.medio) {
    height: 100%;
    background: var(--marmol);
  }

  /* object-fit: contain (no cover) para que piezas altas y angostas
     (p. ej. una silla de barra) se vean completas, sin recortar. */
  .producto__medio-principal :global(.medio img) {
    object-fit: contain;
  }

  .producto__miniaturas {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .producto__miniatura {
    width: 72px;
    height: 72px;
    padding: 0;
    border-radius: 0.6rem;
    overflow: hidden;
    border: 2px solid transparent;
    background: var(--marmol);
    transition: border-color 0.3s var(--ease);
  }

  .producto__miniatura img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .producto__miniatura--activa,
  .producto__miniatura:hover {
    border-color: var(--dorado);
  }

  .producto__titulo {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  .producto__precio {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--carbon);
  }

  .producto__precio span {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--gris);
    margin-top: 0.2rem;
  }

  .producto__resumen {
    margin-top: 1.25rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--gris);
    max-width: 46ch;
  }

  .producto__acciones {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .producto__confianza {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--linea);
    display: grid;
    gap: 0.6rem;
  }

  .producto__confianza li {
    padding-left: 1.5rem;
    position: relative;
    font-size: 0.85rem;
    color: var(--gris);
  }

  .producto__confianza li::before {
    content: "✦";
    position: absolute;
    left: 0;
    top: 0.1rem;
    color: var(--dorado-texto);
    font-size: 0.75rem;
  }

  /* "Sobre esta pieza": va debajo de la lista de confianza, discreta,
     no como bloque oscuro aparte. */
  .producto__extendida {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--linea);
  }

  .producto__extendida h2 {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gris);
  }

  .producto__extendida p {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--gris);
    max-width: 52ch;
  }

  @media (min-width: 900px) {
    .producto__grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: start;
    }
  }

  /* Ficha técnica: menos aire arriba que el resto de secciones para que
     no se sienta como un salto largo justo después de "Sobre esta pieza". */
  .ficha {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .ficha__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .ficha__titulo {
    margin-top: 1rem;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    max-width: 14ch;
  }

  .ficha__lista {
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--linea);
  }

  .ficha__item {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--linea);
  }

  .ficha__item dt {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--carbon);
  }

  .ficha__item dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--gris);
  }

  @media (min-width: 900px) {
    .ficha__grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }

  /* Relacionados */
  .relacionados__titulo {
    margin-top: 1rem;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .relacionados__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .relacionados__tarjeta {
    position: relative;
    display: block;
    border-radius: 1rem;
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }

  .relacionados__tarjeta :global(.medio) {
    height: 100%;
  }

  .relacionados__tarjeta :global(img) {
    transition: transform 0.8s var(--ease);
  }

  .relacionados__tarjeta:hover :global(img:not(.medio__img--error)) {
    transform: scale(1.06);
  }

  .relacionados__ficha {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.25rem;
    background: linear-gradient(to top, rgba(20, 18, 16, 0.85), transparent);
    color: var(--hueso);
  }

  .relacionados__ficha h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .relacionados__ficha span {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.75rem;
    color: var(--hueso-suave);
  }

  @media (max-width: 700px) {
    .relacionados__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Lightbox: foto ampliada con zoom */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .lightbox:not([hidden]) {
    display: flex;
  }

  .lightbox__fondo {
    position: absolute;
    inset: 0;
    border: none;
    background: rgba(20, 18, 16, 0.94);
    cursor: default;
    padding: 0;
  }

  .lightbox__marco {
    position: relative;
    z-index: 1;
    width: min(92vw, 1100px);
    height: min(86vh, 1100px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: auto;
  }

  .lightbox__imagen {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform 0.35s var(--ease);
    transform: scale(1);
    touch-action: pinch-zoom;
  }

  .lightbox__imagen.lightbox__imagen--zoom {
    max-width: none;
    max-height: none;
    width: min(92vw, 1100px);
    transform: scale(2);
    cursor: zoom-out;
  }

  .lightbox__cerrar,
  .lightbox__nav {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 1px solid rgba(242, 235, 222, 0.3);
    background: rgba(20, 18, 16, 0.6);
    color: var(--hueso);
    transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .lightbox__cerrar:hover,
  .lightbox__nav:hover {
    background: rgba(20, 18, 16, 0.85);
    border-color: var(--dorado-claro);
  }

  .lightbox__cerrar svg,
  .lightbox__nav svg {
    width: 20px;
    height: 20px;
  }

  .lightbox__cerrar {
    top: 1.25rem;
    right: 1.25rem;
  }

  .lightbox__nav--prev {
    left: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__nav--next {
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__ayuda {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--hueso-suave);
  }

  @media (max-width: 640px) {
    .lightbox__cerrar,
    .lightbox__nav {
      width: 40px;
      height: 40px;
    }

    .lightbox__ayuda {
      display: none;
    }
  }
</style>

<script>
  // Cambia la foto principal al hacer clic en una miniatura (mejora progresiva:
  // sin JS, todas las fotos siguen siendo accesibles como miniaturas).
  const principal = document.querySelector<HTMLImageElement>("[data-galeria-principal] img");
  const miniaturas = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-galeria-miniatura]"));
  const abrirZoomBoton = document.querySelector<HTMLButtonElement>("[data-abrir-zoom]");
  const lightbox = document.querySelector<HTMLElement>("[data-lightbox]");
  const lightboxImagen = document.querySelector<HTMLImageElement>("[data-lightbox-imagen]");
  const botonesCerrarLightbox = document.querySelectorAll<HTMLButtonElement>("[data-lightbox-cerrar]");
  const botonAnterior = document.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
  const botonSiguiente = document.querySelector<HTMLButtonElement>("[data-lightbox-next]");
  const botonCerrarLightbox = document.querySelector<HTMLButtonElement>(".lightbox__cerrar");

  // Lista completa de fotos: las miniaturas ya representan toda la galería
  // (incluida la foto principal); si no hay miniaturas, solo queda esa foto.
  const fotos = miniaturas.length > 0 ? miniaturas.map((b) => b.dataset.src ?? "") : principal ? [principal.src] : [];
  let indiceActual = 0;
  let elementoConFocoPrevio: HTMLElement | null = null;

  function mostrarFoto(indice: number) {
    if (!principal || fotos.length === 0) return;
    indiceActual = (indice + fotos.length) % fotos.length;
    principal.src = fotos[indiceActual];
    principal.classList.remove("medio__img--error");
    miniaturas.forEach((b, i) => b.classList.toggle("producto__miniatura--activa", i === indiceActual));
  }

  miniaturas.forEach((boton, indice) => {
    boton.addEventListener("click", () => mostrarFoto(indice));
  });

  function actualizarImagenLightbox() {
    if (!lightboxImagen || fotos.length === 0) return;
    lightboxImagen.src = fotos[indiceActual];
    lightboxImagen.classList.remove("lightbox__imagen--zoom");
  }

  // Algunos navegadores móviles no apilan correctamente dos elementos
  // position:fixed (el header y el lightbox); se oculta el header mientras
  // el lightbox está abierto para evitar que se vea "por encima".
  const headerFijo = document.querySelector<HTMLElement>(".header-fijo");

  function abrirLightbox() {
    if (!lightbox || fotos.length === 0) return;
    elementoConFocoPrevio = document.activeElement as HTMLElement;
    actualizarImagenLightbox();
    lightbox.hidden = false;
    document.body.style.overflow = "hidden";
    if (headerFijo) headerFijo.style.visibility = "hidden";
    botonCerrarLightbox?.focus();
  }

  function cerrarLightbox() {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = "";
    if (headerFijo) headerFijo.style.visibility = "";
    lightboxImagen?.classList.remove("lightbox__imagen--zoom");
    elementoConFocoPrevio?.focus();
  }

  abrirZoomBoton?.addEventListener("click", abrirLightbox);
  botonesCerrarLightbox.forEach((boton) => boton.addEventListener("click", cerrarLightbox));

  botonAnterior?.addEventListener("click", () => {
    mostrarFoto(indiceActual - 1);
    actualizarImagenLightbox();
  });

  botonSiguiente?.addEventListener("click", () => {
    mostrarFoto(indiceActual + 1);
    actualizarImagenLightbox();
  });

  lightboxImagen?.addEventListener("click", () => {
    lightboxImagen.classList.toggle("lightbox__imagen--zoom");
  });

  window.addEventListener("keydown", (event) => {
    if (!lightbox || lightbox.hidden) return;
    if (event.key === "Escape") cerrarLightbox();
    if (event.key === "ArrowLeft") {
      mostrarFoto(indiceActual - 1);
      actualizarImagenLightbox();
    }
    if (event.key === "ArrowRight") {
      mostrarFoto(indiceActual + 1);
      actualizarImagenLightbox();
    }
  });
</script>
