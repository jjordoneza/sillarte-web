---
const cifras = [
  { valor: "04", etiqueta: "Tonos cálidos coordinados" },
  { valor: "100%", etiqueta: "Paleta neutra contemporánea" },
  { valor: "6", etiqueta: "Unidades mínimas para precio mayorista" },
  { valor: "24h", etiqueta: "Tiempo de respuesta a cotizaciones" },
];
---

<section class="confianza seccion seccion--oscura sobre-oscuro">
  <div class="contenedor confianza__grid">
    {cifras.map((cifra) => (
      <div class="confianza__item reveal">
        <p class="confianza__valor">{cifra.valor}</p>
        <p class="confianza__etiqueta">{cifra.etiqueta}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .confianza {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .confianza__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .confianza__item {
    text-align: center;
    border-left: 1px solid rgba(242, 235, 222, 0.16);
    padding-left: 1.5rem;
  }

  .confianza__item:first-child {
    border-left: none;
  }

  .confianza__valor {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    color: var(--dorado-claro);
  }

  .confianza__etiqueta {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--hueso-suave);
  }

  @media (max-width: 700px) {
    .confianza__grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2.5rem;
    }
    .confianza__item:nth-child(3) {
      border-left: none;
    }
  }
</style>
