---
// Marquee dorado en movimiento continuo con las propuestas de valor.
const frases = [
  "Diseño que se ve caro",
  "Cuesta accesible",
  "Una colección que combina entre sí",
  "Precios de mayoreo desde 6 unidades",
  "Envíos a todo el país",
];
---

<div class="marquee" role="presentation">
  <div class="marquee__pista">
    {[...frases, ...frases].map((frase) => (
      <span class="marquee__item">
        {frase}
        <span class="marquee__punto" aria-hidden="true">✦</span>
      </span>
    ))}
  </div>
</div>

<style>
  .marquee {
    background: var(--dorado);
    color: var(--carbon);
    overflow: hidden;
    padding-block: 1.1rem;
  }

  .marquee__pista {
    display: flex;
    width: max-content;
    animation: desplazar 32s linear infinite;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding-inline: 1.5rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    white-space: nowrap;
  }

  .marquee__punto {
    font-size: 0.9rem;
    font-style: normal;
  }

  @keyframes desplazar {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__pista {
      animation: none;
    }
  }
</style>
