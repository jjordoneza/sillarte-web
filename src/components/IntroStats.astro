---
const stats = [
  { valor: "6+", etiqueta: "Referencias en stock permanente" },
  { valor: "0", etiqueta: "Intermediarios entre fábrica y tu pedido" },
  { valor: "24h", etiqueta: "Tiempo de respuesta a cotizaciones" },
  { valor: "6", etiqueta: "Unidades mínimas para precio mayorista" },
];
---

<section class="intro seccion seccion--clara">
  <div class="contenedor intro__grid">
    <p class="etiqueta reveal">La colección</p>

    <h2 class="titular intro__titulo reveal">
      <em class="acento-dorado">Precio de fábrica</em>, stock real y diseños que no se ven baratos.
    </h2>

    <dl class="intro__stats reveal">
      {stats.map((stat) => (
        <div class="intro__stat">
          <dt class="intro__valor">{stat.valor}</dt>
          <dd class="intro__etiqueta">{stat.etiqueta}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .intro__grid {
    display: grid;
    gap: 3rem;
  }

  .intro__titulo {
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    max-width: 42ch;
  }

  .intro__stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--linea);
  }

  .intro__valor {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    color: var(--dorado-texto);
  }

  .intro__etiqueta {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--gris);
    max-width: 22ch;
  }

  @media (max-width: 900px) {
    .intro__stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem 1.25rem;
    }
  }
</style>
