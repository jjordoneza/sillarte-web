---
// Botón flotante de WhatsApp, visible en todas las páginas (web y móvil).
import { whatsappLink } from "@/data/site";

const mensaje = "Hola, vengo de la página web y estoy interesado en tus productos, ¿me comparte el catálogo por favor?";
---

<a
  href={whatsappLink(mensaje)}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-flotante"
  aria-label="Escríbenos por WhatsApp"
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm5.8 14.1c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.95-.31-1.64-.6-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.17-1.56-1.17-2.98 0-1.42.74-2.11 1-2.4.26-.29.57-.36.76-.36h.55c.18 0 .42-.07.65.5.24.6.82 2.07.9 2.22.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.36 1.46.3.15.47.13.65-.08.18-.21.75-.87.95-1.17.2-.3.4-.25.66-.15.27.1 1.73.82 2.03.97.3.15.5.22.57.34.07.13.07.73-.17 1.41Z"></path>
  </svg>
</a>

<style>
  .whatsapp-flotante {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 6px 20px rgba(20, 18, 16, 0.35);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .whatsapp-flotante svg {
    width: 30px;
    height: 30px;
  }

  .whatsapp-flotante:hover,
  .whatsapp-flotante:focus-visible {
    transform: scale(1.08);
    box-shadow: 0 8px 24px rgba(20, 18, 16, 0.45);
  }

  @media (max-width: 640px) {
    .whatsapp-flotante {
      right: 1rem;
      bottom: 1rem;
      width: 52px;
      height: 52px;
    }

    .whatsapp-flotante svg {
      width: 27px;
      height: 27px;
    }
  }
</style>
