---
import Medio from "@/components/Medio.astro";
import { clients } from "@/data/clients";
---

<section class="clientes seccion seccion--marmol" aria-labelledby="clientes-titulo">
  <div class="contenedor">
    <div class="clientes__cabecera">
      <p class="etiqueta reveal">Nuestros clientes</p>
      <h2 id="clientes-titulo" class="titular clientes__titulo reveal">Negocios que ya confían en Sillarte.</h2>
    </div>
  </div>

  <div class="clientes__pista-envoltorio reveal" data-clientes-carrusel>
    <div class="clientes__pista" data-clientes-pista>
      {[...clients, ...clients].map((client) => (
        <a
          class="clientes__tarjeta"
          href={`https://instagram.com/${client.instagram}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Medio
            src={client.image}
            alt={`${client.business}, ${client.city}`}
            marcador={`Foto de cliente — ${client.business}`}
            class="clientes__medio"
          />
          <div class="clientes__info">
            <span class="clientes__negocio">{client.business}</span>
            <span class="clientes__ciudad">{client.city}</span>
            <span class="clientes__ig">@{client.instagram}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .clientes__cabecera {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .clientes__titulo {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
  }

  .clientes__pista-envoltorio {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
  }

  .clientes__pista-envoltorio::-webkit-scrollbar {
    display: none;
  }

  .clientes__pista {
    display: flex;
    width: max-content;
    gap: 1.5rem;
    padding-inline: 1.5rem;
  }

  .clientes__tarjeta {
    display: block;
    flex: 0 0 240px;
    border-radius: 1rem;
    overflow: hidden;
    background: var(--hueso);
    border: 1px solid var(--linea);
    transition: border-color 0.3s var(--ease);
  }

  .clientes__tarjeta:hover {
    border-color: var(--dorado);
  }

  .clientes__tarjeta :global(.clientes__medio) {
    aspect-ratio: 4 / 5;
  }

  .clientes__info {
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .clientes__negocio {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--carbon);
  }

  .clientes__ciudad {
    font-size: 0.78rem;
    color: var(--gris);
  }

  .clientes__ig {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--dorado-texto);
  }

</style>

<script>
  // Antes el carrusel sólo avanzaba con una animación CSS (transform),
  // lo que en móvil no se podía pausar ni mover con el dedo. Ahora la
  // pista es un contenedor con scroll nativo (overflow-x: auto) que el
  // usuario puede arrastrar/deslizar libremente, y el auto-desplazamiento
  // se hace por JS moviendo scrollLeft, pausándose mientras hay
  // interacción táctil, con mouse o con la rueda.
  const envoltorio = document.querySelector<HTMLElement>("[data-clientes-carrusel]");
  const pista = document.querySelector<HTMLElement>("[data-clientes-pista]");
  const prefiereMenosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (envoltorio && pista && !prefiereMenosMovimiento) {
    const velocidad = 0.45; // px por frame
    let pausado = false;
    // scrollLeft se redondea a pixeles enteros: si sumáramos el
    // incremento sub-pixel directo sobre scrollLeft, el navegador lo
    // trunca en cada frame y el carrusel nunca avanza. Por eso llevamos
    // la posición real en esta variable flotante aparte.
    let posicion = envoltorio.scrollLeft;
    let reanudarTimeout: ReturnType<typeof setTimeout>;

    const pausarTemporalmente = () => {
      pausado = true;
      clearTimeout(reanudarTimeout);
      reanudarTimeout = setTimeout(() => {
        pausado = false;
      }, 2500);
    };

    envoltorio.addEventListener("pointerdown", pausarTemporalmente);
    envoltorio.addEventListener("touchstart", pausarTemporalmente, { passive: true });
    envoltorio.addEventListener("wheel", pausarTemporalmente, { passive: true });
    envoltorio.addEventListener("mouseenter", () => {
      clearTimeout(reanudarTimeout);
      pausado = true;
    });
    envoltorio.addEventListener("mouseleave", () => {
      pausado = false;
    });

    const avanzar = () => {
      if (pausado) {
        // Mientras el usuario arrastra o el mouse está encima, seguimos
        // la posición real para retomar suave cuando se reanude.
        posicion = envoltorio.scrollLeft;
      } else {
        const mitad = pista.scrollWidth / 2;
        posicion += velocidad;
        if (posicion >= mitad) {
          posicion -= mitad;
        }
        envoltorio.scrollLeft = posicion;
      }
      requestAnimationFrame(avanzar);
    };

    requestAnimationFrame(avanzar);
  }
</script>
