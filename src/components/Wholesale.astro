---
import { siteConfig } from "@/data/site";
import { products } from "@/data/products";

const beneficios = [
  "Precios de mayoreo desde 6 unidades por referencia",
  "Catálogo con fichas técnicas, medidas y materiales",
  "Stock permanente, sin tiempos de espera por importación",
  "Despachos a todo el país con seguimiento del pedido",
];

// Acepta un teléfono (7+ dígitos, con espacios/guiones/+ opcionales) o un
// correo. Se arma como variable JS (en vez de escribirlo directo en el
// atributo pattern) porque Astro serializa los atributos estáticos como
// string de JS y se come las barras invertidas de \s, \-, \. y \+.
const contactoPattern = "^(\\+?[0-9][0-9\\s\\-]{6,14}|[^\\s@]+@[^\\s@]+\\.[^\\s@]+)$";
---

<section class="mayoreo seccion seccion--oscura sobre-oscuro" id="mayoreo">
  <div class="contenedor mayoreo__grid">
    <div class="mayoreo__texto">
      <p class="etiqueta etiqueta--sobre-oscuro reveal">Mayoreo</p>
      <h2 class="titular mayoreo__titulo reveal">
        Amoblamos <em class="acento-dorado">tu negocio, tu hogar o tu terraza</em> con precios de fábrica y stock real.
      </h2>
      <p class="mayoreo__copy reveal">
        Trabajamos con hogares, negocios y revendedores que buscan mobiliario con buen
        precio, stock disponible y buenos tiempos de entrega.
      </p>

      <ul class="mayoreo__beneficios reveal">
        {beneficios.map((beneficio) => (
          <li>{beneficio}</li>
        ))}
      </ul>

      <a href="/catalogo.pdf" class="boton boton--claro mayoreo__descarga reveal" download>
        Descargar catálogo PDF
      </a>
    </div>

    <form class="mayoreo__form reveal" id="form-cotizacion" aria-labelledby="form-titulo">
      <h3 id="form-titulo">Solicita tu cotización</h3>

      <div class="mayoreo__campo">
        <label for="nombre-negocio">Nombre y negocio</label>
        <input type="text" id="nombre-negocio" name="nombre-negocio" required autocomplete="name" />
      </div>

      <div class="mayoreo__campo">
        <label for="telefono-contacto">Teléfono o correo de contacto</label>
        <input
          type="text"
          id="telefono-contacto"
          name="contacto"
          required
          autocomplete="tel"
          pattern={contactoPattern}
          title="Escribe un número de teléfono válido (mínimo 7 dígitos) o un correo electrónico."
        />
      </div>

      <span class="mayoreo__filas-etiqueta">Piezas de interés y cantidad aproximada</span>
      <div class="mayoreo__filas" data-filas>
        <div class="mayoreo__fila" data-fila>
          <div class="mayoreo__campo mayoreo__campo--pieza">
            <label class="solo-lectores">Pieza de interés</label>
            <select data-fila-producto required>
              <option value="">Selecciona una pieza</option>
              {products.map((product) => (
                <option value={`${product.name} (${product.ref})`}>
                  {product.name} ({product.ref})
                </option>
              ))}
              <option value="Toda la colección">Toda la colección</option>
            </select>
          </div>
          <div class="mayoreo__campo mayoreo__campo--cantidad">
            <label class="solo-lectores">Cantidad aproximada</label>
            <input type="number" data-fila-cantidad min="1" placeholder="Cant." required />
          </div>
          <button type="button" class="mayoreo__quitar-fila" data-quitar-fila aria-label="Quitar esta pieza" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="5" y1="5" x2="19" y2="19"></line>
              <line x1="19" y1="5" x2="5" y2="19"></line>
            </svg>
          </button>
        </div>
      </div>

      <button type="button" class="mayoreo__agregar-fila" data-agregar-fila>+ Agregar otra pieza</button>

      <div class="mayoreo__acciones">
        <button type="submit" class="boton boton--dorado" data-envio="whatsapp">Enviar por WhatsApp</button>
        <button type="submit" class="boton boton--linea mayoreo__boton-mail" data-envio="mail">Enviar por correo</button>
      </div>

      <p class="mayoreo__precio-nota">Precios de mayoreo: <strong>$—</strong> (según referencia y cantidad).</p>
    </form>
  </div>
</section>

<template data-fila-plantilla>
  <div class="mayoreo__fila" data-fila>
    <div class="mayoreo__campo mayoreo__campo--pieza">
      <label class="solo-lectores">Pieza de interés</label>
      <select data-fila-producto required>
        <option value="">Selecciona una pieza</option>
        {products.map((product) => (
          <option value={`${product.name} (${product.ref})`}>
            {product.name} ({product.ref})
          </option>
        ))}
        <option value="Toda la colección">Toda la colección</option>
      </select>
    </div>
    <div class="mayoreo__campo mayoreo__campo--cantidad">
      <label class="solo-lectores">Cantidad aproximada</label>
      <input type="number" data-fila-cantidad min="1" placeholder="Cant." required />
    </div>
    <button type="button" class="mayoreo__quitar-fila" data-quitar-fila aria-label="Quitar esta pieza">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="5" y1="5" x2="19" y2="19"></line>
        <line x1="19" y1="5" x2="5" y2="19"></line>
      </svg>
    </button>
  </div>
</template>

<style>
  .mayoreo__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .mayoreo__titulo {
    margin-top: 1rem;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    max-width: 18ch;
  }

  .mayoreo__copy {
    margin-top: 1.5rem;
    max-width: 46ch;
    color: var(--hueso-suave);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .mayoreo__beneficios {
    margin-top: 2rem;
    display: grid;
    gap: 0.9rem;
  }

  .mayoreo__beneficios li {
    padding-left: 1.5rem;
    position: relative;
    color: var(--hueso-suave);
    font-size: 0.95rem;
  }

  .mayoreo__beneficios li::before {
    content: "✦";
    position: absolute;
    left: 0;
    color: var(--dorado-claro);
    font-size: 0.75rem;
    top: 0.35rem;
  }

  .mayoreo__descarga {
    margin-top: 2.5rem;
  }

  .mayoreo__form {
    background: var(--carbon-2);
    border: 1px solid rgba(242, 235, 222, 0.12);
    border-radius: 1.25rem;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    display: grid;
    gap: 1.25rem;
    align-self: start;
  }

  .mayoreo__form h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--hueso);
  }

  .mayoreo__campo {
    display: grid;
    gap: 0.5rem;
  }

  .mayoreo__campo label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hueso-suave);
  }

  .mayoreo__campo input,
  .mayoreo__campo select {
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: 0.6rem;
    border: 1px solid rgba(242, 235, 222, 0.22);
    background: var(--carbon);
    color: var(--hueso);
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }

  .mayoreo__campo select {
    appearance: none;
  }

  .mayoreo__campo input::placeholder {
    color: var(--gris);
  }

  .mayoreo__filas-etiqueta {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hueso-suave);
  }

  .mayoreo__filas {
    display: grid;
    gap: 0.75rem;
  }

  .mayoreo__fila {
    display: grid;
    grid-template-columns: 1fr 5.5rem auto;
    gap: 0.6rem;
    align-items: center;
  }

  .mayoreo__campo--pieza,
  .mayoreo__campo--cantidad {
    gap: 0;
  }

  .mayoreo__quitar-fila {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(242, 235, 222, 0.22);
    background: transparent;
    color: var(--hueso-suave);
  }

  .mayoreo__quitar-fila[hidden] {
    display: none;
  }

  .mayoreo__quitar-fila svg {
    width: 14px;
    height: 14px;
  }

  .mayoreo__quitar-fila:hover {
    color: var(--hueso);
    border-color: rgba(242, 235, 222, 0.4);
  }

  .mayoreo__agregar-fila {
    justify-self: start;
    background: transparent;
    border: none;
    color: var(--dorado-claro);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .mayoreo__agregar-fila:hover {
    text-decoration: underline;
  }

  .mayoreo__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .mayoreo__boton-mail {
    color: var(--hueso);
    border-color: rgba(242, 235, 222, 0.4);
  }

  .mayoreo__boton-mail:hover {
    background: rgba(242, 235, 222, 0.12);
  }

  .mayoreo__precio-nota {
    font-size: 0.78rem;
    color: var(--hueso-suave);
  }

  @media (min-width: 960px) {
    .mayoreo__grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  @media (max-width: 420px) {
    .mayoreo__fila {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "producto producto"
        "cantidad quitar";
    }

    .mayoreo__campo--pieza {
      grid-area: producto;
    }

    .mayoreo__campo--cantidad {
      grid-area: cantidad;
    }

    .mayoreo__quitar-fila {
      grid-area: quitar;
    }
  }
</style>

<script is:inline define:vars={{ whatsappNumber: siteConfig.whatsappNumber, email: siteConfig.email }}>
  // Envía la solicitud de cotización por WhatsApp o correo, según el botón usado.
  // Permite varias piezas (con su propia cantidad) en un mismo envío: cada
  // fila se agrega/quita dinámicamente y se lista aparte en el mensaje.
  // NOTA: `whatsappNumber` y `email` vienen de src/data/site.ts — actualizarlos ahí.
  const form = document.getElementById("form-cotizacion");
  const filasContenedor = document.querySelector("[data-filas]");
  const plantillaFila = document.querySelector("[data-fila-plantilla]");
  const botonAgregarFila = document.querySelector("[data-agregar-fila]");

  function actualizarBotonesQuitar() {
    if (!filasContenedor) return;
    const filas = filasContenedor.querySelectorAll("[data-fila]");
    filas.forEach((fila) => {
      const boton = fila.querySelector("[data-quitar-fila]");
      if (boton) boton.hidden = filas.length <= 1;
    });
  }

  function activarQuitarFila(fila) {
    fila.querySelector("[data-quitar-fila]")?.addEventListener("click", () => {
      fila.remove();
      actualizarBotonesQuitar();
    });
  }

  if (filasContenedor) {
    filasContenedor.querySelectorAll("[data-fila]").forEach(activarQuitarFila);
  }

  botonAgregarFila?.addEventListener("click", () => {
    if (!filasContenedor || !plantillaFila) return;
    const nuevaFila = plantillaFila.content.firstElementChild.cloneNode(true);
    filasContenedor.appendChild(nuevaFila);
    activarQuitarFila(nuevaFila);
    actualizarBotonesQuitar();
    nuevaFila.querySelector("[data-fila-producto]")?.focus();
  });

  form?.addEventListener("submit", (event) => {
    const submitter = event.submitter;
    const via = submitter?.dataset.envio ?? "whatsapp";
    event.preventDefault();

    const data = new FormData(form);
    const nombre = data.get("nombre-negocio");
    const contacto = data.get("contacto");

    const piezas = Array.from(filasContenedor?.querySelectorAll("[data-fila]") ?? [])
      .map((fila) => ({
        producto: fila.querySelector("[data-fila-producto]")?.value ?? "",
        cantidad: fila.querySelector("[data-fila-cantidad]")?.value ?? "",
      }))
      .filter((fila) => fila.producto && fila.cantidad);

    const listadoPiezas = piezas
      .map((fila, indice) => `${indice + 1}. ${fila.producto} — ${fila.cantidad} unidades aprox.`)
      .join("\n");

    const mensaje =
      `Hola, quiero cotizar al por mayor la colección 2026 de Sillarte.\n` +
      `Nombre/negocio: ${nombre}\n` +
      `Contacto: ${contacto}\n\n` +
      `Piezas de interés:\n${listadoPiezas}`;

    if (via === "mail") {
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(
        "Cotización de mayoreo — Colección 2026"
      )}&body=${encodeURIComponent(mensaje)}`;
    } else {
      window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(mensaje)}`, "_blank", "noopener");
    }
  });
</script>
