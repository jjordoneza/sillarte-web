---
import { siteConfig, whatsappLink } from "@/data/site";

// Rutas absolutas (con "/" al inicio) para que funcionen igual desde la
// portada que desde una página de detalle de producto.
const links = [
  { href: "/#destacados", label: "Colección" },
  { href: "/#destacados", label: "Destacados" },
  { href: "/#categorias", label: "Categorías" },
  { href: "/#mayoreo", label: "Mayoreo" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="nav" id="nav" data-nav>
  <div class="contenedor nav__barra">
    <a href="/" class="nav__logo">{siteConfig.name}</a>

    <nav class="nav__links" aria-label="Navegación principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="nav__acciones">
      <a
        class="boton boton--dorado nav__cta"
        href={whatsappLink("Hola, quiero cotizar al por mayor la colección Cálida de Sillarte.")}
        target="_blank"
        rel="noopener noreferrer"
      >
        Cotizar al por mayor
      </a>

      <button
        class="nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-toggle
      >
        <span class="solo-lectores">Abrir menú</span>
        <span class="nav__toggle-linea" aria-hidden="true"></span>
        <span class="nav__toggle-linea" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="menu-movil" id="menu-movil" data-menu-panel hidden>
  <nav aria-label="Navegación móvil">
    <ul>
      {links.map((link) => (
        <li><a href={link.href} data-menu-link>{link.label}</a></li>
      ))}
    </ul>
  </nav>
  <a
    class="boton boton--dorado"
    href={whatsappLink("Hola, quiero cotizar al por mayor la colección Cálida de Sillarte.")}
    target="_blank"
    rel="noopener noreferrer"
  >
    Cotizar al por mayor
  </a>
</div>

<style>
  .nav {
    background: transparent;
    transition: background-color 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  .nav[data-scrolled="true"] {
    background: rgba(20, 18, 16, 0.92);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .nav__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.1rem;
  }

  .nav__logo {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--hueso);
    letter-spacing: 0.02em;
  }

  .nav__links ul {
    display: flex;
    gap: 2rem;
  }

  .nav__links a {
    color: var(--hueso-suave);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.3s var(--ease);
  }

  .nav__links a:hover {
    color: var(--dorado-claro);
  }

  .nav__acciones {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav__cta {
    padding: 0.7rem 1.4rem;
    font-size: 0.72rem;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid rgba(242, 235, 222, 0.35);
    border-radius: 50%;
  }

  .nav__toggle-linea {
    display: block;
    width: 18px;
    height: 1.5px;
    margin-inline: auto;
    background: var(--hueso);
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }

  .nav__toggle[aria-expanded="true"] .nav__toggle-linea:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav__toggle[aria-expanded="true"] .nav__toggle-linea:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .menu-movil {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: var(--carbon);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    padding: 2rem;
    text-align: center;
  }

  .menu-movil .boton {
    white-space: normal;
    max-width: 100%;
  }

  /* El atributo hidden manda: sólo se muestra cuando JS lo quita. */
  .menu-movil:not([hidden]) {
    display: flex;
  }

  .menu-movil ul {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  .menu-movil a {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--hueso);
  }

  .menu-movil a:hover {
    color: var(--dorado-claro);
  }

  @media (max-width: 900px) {
    .nav__links {
      display: none;
    }

    .nav__cta {
      display: none;
    }

    .nav__toggle {
      display: flex;
    }
  }
</style>

<script>
  // Nav: sólido al hacer scroll + menú hamburguesa a pantalla completa.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>("[data-menu-link]");

  const setScrolled = () => {
    if (!nav) return;
    nav.dataset.scrolled = window.scrollY > 24 ? "true" : "false";
  };
  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });

  const closeMenu = () => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", "false");
    panel.hidden = true;
    document.body.style.overflow = "";
  };

  const openMenu = () => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", "true");
    panel.hidden = false;
    document.body.style.overflow = "hidden";
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    isOpen ? closeMenu() : openMenu();
  });

  menuLinks.forEach((link) => link.addEventListener("click", closeMenu));

  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>
