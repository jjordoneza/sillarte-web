---
import Medio from "@/components/Medio.astro";
import { categories } from "@/data/products";
---

<section class="categorias seccion seccion--clara" id="categorias">
  <div class="contenedor">
    <div class="categorias__cabecera">
      <p class="etiqueta reveal">Explora por categoría</p>
      <h2 class="titular categorias__titulo reveal">Encuentra la pieza para tu espacio.</h2>
    </div>

    <div class="categorias__grid">
      {categories.map((cat) => (
        <a href={cat.href} class="categorias__tile reveal">
          <Medio
            src={cat.image}
            alt={`Categoría ${cat.name} de la colección 2026`}
            marcador={`Escena de estudio — Categoría ${cat.name}`}
            class="medio--marcador-arriba"
          />
          <div class="categorias__info">
            <h3>{cat.name}</h3>
            <p>{cat.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .categorias__cabecera {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 40ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .categorias__titulo {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
  }

  .categorias__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .categorias__tile {
    position: relative;
    display: block;
    border-radius: 1rem;
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }

  .categorias__tile :global(.medio) {
    height: 100%;
  }

  .categorias__tile :global(img) {
    transition: transform 0.8s var(--ease);
  }

  .categorias__tile:hover :global(img:not(.medio__img--error)) {
    transform: scale(1.06);
  }

  .categorias__tile::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 18, 16, 0.75), transparent 55%);
  }

  .categorias__info {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.25rem;
    color: var(--hueso);
    z-index: 1;
  }

  .categorias__info h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .categorias__info p {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--hueso-suave);
  }

  @media (max-width: 900px) {
    .categorias__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
