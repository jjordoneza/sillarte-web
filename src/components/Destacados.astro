---
import Medio from "@/components/Medio.astro";
import { products } from "@/data/products";
---

<section class="destacados seccion seccion--marmol" id="destacados">
  <div class="contenedor">
    <div class="destacados__cabecera">
      <p class="etiqueta reveal">Piezas destacadas</p>
      <h2 class="titular destacados__titulo reveal">
        Seis piezas, <em class="acento-dorado">un solo lenguaje</em>.
      </h2>
    </div>

    <div class="destacados__masonry">
      {products.map((product, index) => (
        <a
          href={`#mayoreo`}
          class:list={["destacados__pieza", "reveal", { "destacados__pieza--alta": index % 3 === 1 }]}
          aria-label={`${product.name}, referencia ${product.ref}. Ir a cotización de mayoreo.`}
        >
          <Medio
            src={product.scene}
            alt={`${product.name}, ${product.detail}`}
            marcador={`Escena de estudio — ${product.name}`}
            class="medio--marcador-arriba"
          />
          <div class="destacados__ficha">
            <span class="destacados__categoria">{product.category}</span>
            <h3>{product.name}</h3>
            <span class="destacados__ref">Ref. {product.ref}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .destacados__cabecera {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 40ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .destacados__titulo {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
  }

  .destacados__masonry {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .destacados__pieza {
    position: relative;
    display: block;
    border-radius: 1rem;
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }

  .destacados__pieza :global(.medio) {
    height: 100%;
  }

  /* Desfase sutil tipo masonry en la columna central. */
  .destacados__pieza--alta {
    aspect-ratio: 3 / 4.6;
    margin-top: 2.5rem;
  }

  .destacados__pieza :global(img) {
    transition: transform 0.8s var(--ease);
  }

  .destacados__pieza:hover :global(img:not(.medio__img--error)) {
    transform: scale(1.06);
  }

  .destacados__ficha {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(20, 18, 16, 0.85), transparent);
    color: var(--hueso);
  }

  .destacados__categoria {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dorado-claro);
  }

  .destacados__ficha h3 {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .destacados__ref {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.75rem;
    color: var(--hueso-suave);
  }

  @media (max-width: 900px) {
    .destacados__masonry {
      grid-template-columns: repeat(2, 1fr);
    }
    .destacados__pieza--alta {
      aspect-ratio: 3 / 4;
      margin-top: 0;
    }
  }

  @media (max-width: 560px) {
    .destacados__masonry {
      grid-template-columns: 1fr;
    }
  }
</style>
